# Copy to .env and replace every placeholder. Never commit .env.

# --- Ollama ---
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_FAST_MODEL=qwen3:4b-instruct
OLLAMA_REASONING_MODEL=qwen3.5:9b

# Existing Intake Agent uses this model
OLLAMA_MODEL=qwen3:4b-instruct

# --- Legal Sources admin ---
# 0 (default) removes /admin/login, /admin/laws and /admin/legal-sources/*.
TOR_LAW_ADMIN_ENABLED=0

# Administrator key: used on the /admin/login page and as the
# X-Admin-Key header for API clients. At least 32 characters.
# Required when TOR_LAW_ADMIN_ENABLED=1 (startup fails otherwise).
TOR_LAW_ADMIN_KEY=replace-with-a-long-random-admin-key

# Admin browser session lifetime in minutes (5-240).
TOR_LAW_ADMIN_SESSION_MINUTES=30

# 1 (default) marks the session cookie Secure. Only set 0 if a
# browser refuses the cookie over plain-http local testing.
TOR_LAW_ADMIN_COOKIE_SECURE=1

# --- Debug ---
# 1 enables /docs, /redoc and /openapi.json. Keep 0 on public demos.
TOR_LAW_DEBUG=0

# AI analysis (/intake/analyze) is limited to direct local requests
# and signed-in administrators until resource protection (P0B) exists.

# --- AI resource protection (P0B.1) ---
# Simultaneous Ollama inferences (1-4). Extra requests get HTTP 503.
TOR_LAW_AI_MAX_CONCURRENT=1

# Per-client analyses allowed per window; extra requests get HTTP 429.
# Clients are keyed by CF-Connecting-IP only when the request comes
# from local cloudflared; X-Forwarded-For is never trusted.
TOR_LAW_AI_RATE_LIMIT=3
TOR_LAW_AI_RATE_WINDOW_SECONDS=600

# Limits are in memory: run a single uvicorn worker.

# TEMPORARY team testing: 1 lets requests arriving through the local
# Cloudflare Tunnel run AI analysis (anyone with the tunnel URL).
# Rate and concurrency limits still apply. Keep 0 otherwise.
# Start the server with scripts/run_server.py (or uvicorn with
# --no-proxy-headers), otherwise tunnel requests are not recognised.
# Never expose Ollama (port 11434) itself; keep OLLAMA_HOST on
# 127.0.0.1.
TOR_LAW_ALLOW_TUNNEL_AI=0
